# =============================================================================
# nvHive — environment variable template
#
# nvh reads KEY=VALUE lines from $NVH_HOME/config/.env and from ~/.hive/.env
# (where `nvh setup` writes keys). Variables already set in the shell win, and
# values are taken literally — no quotes, no inline comments, no $VAR expansion.
#
#   cp .env.example "$NVH_HOME/config/.env"
#
# NVH_HOME itself must already be exported when nvh starts (see below).
# =============================================================================

# -----------------------------------------------------------------------------
# Persistent home — venv, models, config, state and logs all live here.
# On a rented GPU desktop this must be the volume that survives reconnects.
# install.sh auto-detects it and appends an export to your shell profile
# ("# >>> nvhive rootless env >>>"); to choose it yourself, export it before
# installing:
#   export NVH_HOME=/mnt/persist/nvhive
# Per-component overrides default to subdirectories of NVH_HOME:
#   NVH_BIN=$NVH_HOME/bin   NVH_STATE=$NVH_HOME/state   NVH_LOGS=$NVH_HOME/logs
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Cloud LLM API keys (leave blank to disable that provider)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# nvHive API (`nvh serve`) — leave HIVE_API_KEY blank for open/local mode;
# set it before binding the API beyond localhost.
# -----------------------------------------------------------------------------
HIVE_API_KEY=
HIVE_CORS_ORIGINS=http://localhost:3000
HIVE_LOG_LEVEL=INFO
HIVE_LOG_FORMAT=text

# -----------------------------------------------------------------------------
# Ollama — the rootless binary under $NVH_HOME/bin listens here by default
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434

# -----------------------------------------------------------------------------
# Web UI — where the browser reaches the API; change only if you expose the
# API on another host or port
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
